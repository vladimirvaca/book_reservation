# Production environment for the book_reservation container.
# Copy to /opt/book_reservation/.env on the Lightsail host (one-time setup).

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=False

# 127.0.0.1 is required — the Docker HEALTHCHECK and the deploy smoke test
# probe http://127.0.0.1:8000/healthz from inside/beside the container.
DJANGO_ALLOWED_HOSTS=your-domain-or-public-ip,127.0.0.1,localhost

# Uncomment when serving under a domain so POST requests pass the CSRF
# Origin check (scheme included):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://books.example.com

# Host port docker compose publishes (put nginx/caddy in front for TLS):
# HOST_PORT=8000

# IMAGE is appended/updated automatically by deploy/deploy.sh on every
# deploy — it pins the exact release tag currently running. Do not edit.
